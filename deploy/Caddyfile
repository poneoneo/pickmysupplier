# Caddy obtient et renouvelle tout seul le certificat HTTPS (Let's Encrypt)
# pour $DOMAIN, et relaie les websockets de Streamlit sans configuration.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8501

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Une seule adresse officielle : www.<domaine> redirige (301) vers <domaine>.
# Caddy obtient aussi un certificat pour www, sinon la redirection HTTPS
# échouerait avant même d'être servie.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
